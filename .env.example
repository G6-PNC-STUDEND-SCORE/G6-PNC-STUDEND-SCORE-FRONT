# ────────────────────────────────────────────────────────────────
# Frontend Environment Variables
# ────────────────────────────────────────────────────────────────
# This file is read by Vite at build time. Variables must be
# prefixed with VITE_ to be exposed to client-side code.
# ────────────────────────────────────────────────────────────────

# ────────────────────────────────────────────────────────────────
# API Configuration
# ────────────────────────────────────────────────────────────────
# Base URL for all backend API requests (used by src/services/apiHttp.ts)
# Must include /api suffix — backend routes are prefixed in routes/api.php
# For local dev with `php artisan serve`: http://127.0.0.1:8000/api
# For Docker: http://localhost:8000/api
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# ────────────────────────────────────────────────────────────────
# Google OAuth 2.0 (Client-side)
# ────────────────────────────────────────────────────────────────
# Google OAuth Client ID — get from Google Cloud Console
# https://console.cloud.google.com/apis/credentials
# Create an "OAuth 2.0 Client ID" of type "Web application"
# IMPORTANT: This is a PUBLIC value — it's safe to commit to source control

VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google OAuth redirect URI — must exactly match one of the
# "Authorized redirect URIs" configured in Google Cloud Console
# For local dev: http://localhost:5173/oauth2callback
# For production: https://your-domain.com/oauth2callback
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/oauth2callback
